[layer_names]

2d_render/layer_1="Inside"
2d_render/layer_2="Outside"
2d_render/layer_3="Player and Conductor"
2d_render/layer_4="Movable Objects"
2d_physics/layer_1="Player"
2d_physics/layer_2="Triggers"
2d_physics/layer_3="Conductor"
2d_physics/layer_4="Collectibles"
2d_physics/layer_5="Pushers"
2d_physics/layer_6="Jumpable"
2d_physics/layer_7="Enemies"
2d_physics/layer_8="Pushable"
2d_physics/layer_9="Duckable"
2d_physics/layer_10="LaserBlocker"
2d_physics/layer_11="SelfDetect"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true

[rhythm_rail]

DeveloperOptions/test_world=1
DeveloperOptions/test_level=1
DeveloperOptions/run_test_level_on_startup=true
DeveloperOptions/show_laser_timing_hints=true
