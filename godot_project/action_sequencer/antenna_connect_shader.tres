// FloatOp:9
	float n_out9p0 = n_out3p4 - n_out10p0;


// FloatOp:20
	float n_out20p0 = n_out9p0 + n_out15p4;


// Output:0
	COLOR.rgb = n_out22p0;
	COLOR.a = n_out20p0;


}
