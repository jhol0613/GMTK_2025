// VectorOp:17
	vec2 n_out17p0 = vec2(n_out14p0) * n_out26p0;


// UVFunc:16
	vec2 n_in16p1 = vec2(1.00000, 1.00000);
	vec2 n_out16p0 = n_out17p0 * n_in16p1 + UV;


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(background_texture, n_out16p0);
	float n_out15p4 = n_out15p0.a;


// VectorOp:21
	vec4 n_out21p0 = n_out7p0 * n_out15p0;


// VectorOp:22
	vec3 n_out22p0 = vec3(n_out13p0.xyz) + vec3(n_out21p0.xyz);


// FloatParameter:10
